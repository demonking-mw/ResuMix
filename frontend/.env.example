# ResuMix frontend configuration.
# Copy to .env:  cp .env.example .env
# Both values are optional; the defaults work for a local backend.

# Where the local backend listens.
VITE_API_BASE_URL=http://localhost:5001

# Optional. Leave empty to hide the "Sign in with Google" button and use
# email/password only. Google sign-in needs a client id registered with Google,
# so it cannot work fully offline.
VITE_GOOGLE_CLIENT_ID=
