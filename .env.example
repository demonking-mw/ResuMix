# ResuMix local configuration.
# Copy to .env and edit:  cp .env.example .env
# scripts/setup.sh does this for you and fills in JWT_REAUTH_SECRET.
#
# Every setting below defaults to something that runs on this machine.
# Nothing here points at a hosted service.

# ---------------------------------------------------------------- database --
# Empty  -> local SQLite file at data/resumix.db (recommended, zero setup).
# sqlite:///relative/or/absolute.db  -> SQLite somewhere else.
# postgresql://user:pass@host/db     -> only if you deliberately want Postgres
#                                       (also: pip install "psycopg[binary]" psycopg-pool)
DATABASE_URL=

# Alternative way to move the SQLite file (ignored when DATABASE_URL is set).
# RESUMIX_DB_PATH=data/resumix.db

# -------------------------------------------------------------------- auth --
# Secret used to sign the session/reauth JWTs. Must be set.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_REAUTH_SECRET=

# ----------------------------------------------------------- language model --
# Job descriptions are parsed with an OpenAI-compatible chat API.
#
# Option A - OpenAI: set OPENAI_KEY, leave OPENAI_BASE_URL empty.
# Option B - fully offline: run Ollama / LM Studio / vLLM, then set
#            OPENAI_BASE_URL=http://localhost:11434/v1
#            OPENAI_MODEL=llama3.1
#            (OPENAI_KEY can stay empty for local servers)
OPENAI_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------- embedding model --
# Sentence-transformer used to score resume lines against a job description.
# Empty -> models/all-mpnet-base-v2 if it exists, otherwise the model is
# downloaded once from Hugging Face and cached.
# Pre-download it with: python scripts/fetch_model.py
OPT_MODEL_PATH=

# ---------------------------------------------------------------- PDF font --
# Optional. A .ttf file (or a directory of Regular/Bold/Italic faces) used for
# the generated PDF. Empty -> a Unicode system font is detected automatically,
# with built-in CID fonts covering Chinese, Japanese and Korean.
RESUMIX_PDF_FONT=

# ------------------------------------------------------------------ server --
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5001
FLASK_ENV=development

# Extra browser origins allowed to call the API, comma separated.
# localhost:3000 and localhost:5173 are always allowed.
CORS_ORIGINS=
